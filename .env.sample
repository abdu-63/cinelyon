# Configuration CinéLyon
# Copiez ce fichier en .env et remplissez les valeurs

# ──────────────────────────────────────────────────
# SCRAPING (scrape.py + GitHub Actions)
# ──────────────────────────────────────────────────

# Clé API TMDB – https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Clé API OMDB (optionnel) – https://www.omdbapi.com/apikey.aspx (gratuit jusqu'à 1000 req/jour)
# Permet d'afficher les notes Rotten Tomatoes sur les pages film
OMDB_API_KEY=

# Clé SERVICE ROLE Supabase (accès admin, écriture en base)
# Supabase Dashboard → Project Settings → API → service_role
# ⚠️ Ne jamais exposer côté client ni sur Vercel
SUPABASE_SERVICE_ROLE_KEY=

# Liste des cinémas au format JSON
# Trouver l'ID dans l'URL Allociné : salle_gen_csalle=P8507.html → P8507
THEATERS=[{"id": "P8507", "name": "Pathé Carré de Soie", "latitude": 45.7641958, "longitude": 4.9212527}]

# ──────────────────────────────────────────────────
# APPLICATION WEB (app.py + Vercel)
# ──────────────────────────────────────────────────

# URL de votre projet Supabase
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=

# Clé ANON publique Supabase (lecture seule, sûre côté client)
SUPABASE_ANON_KEY=

# Titre affiché sur le site
WEBSITE_TITLE=CinéLyon

# ──────────────────────────────────────────────────
# AUTOMATISATION INSTAGRAM (scripts/instagram/)
# ──────────────────────────────────────────────────

# Hébergement temporaire des images avant publication (gratuit, sans CB)
# Créer un compte sur https://imgbb.com → Account → Settings → API
IMGBB_API_KEY=

# ID numérique du compte Instagram professionnel
# Trouver via : https://graph.facebook.com/me/accounts?access_token=TON_TOKEN
# Puis : https://graph.facebook.com/v21.0/PAGE_ID?fields=instagram_business_account&access_token=TON_TOKEN
INSTAGRAM_ACCOUNT_ID=

# Token d'accès Meta Graph API (longue durée = 60 jours)
# ⚠️ Doit commencer par "EAA..." — Générer sur https://developers.facebook.com/tools/explorer
# Permissions requises : instagram_basic, instagram_content_publish, pages_read_engagement
# Pour obtenir un token longue durée :
# GET https://graph.facebook.com/v21.0/oauth/access_token?grant_type=fb_exchange_token
#     &client_id=TON_APP_ID&client_secret=TON_APP_SECRET&fb_exchange_token=TON_SHORT_TOKEN
INSTAGRAM_ACCESS_TOKEN=
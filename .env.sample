# Configuration CinéLyon
# Copiez ce fichier en .env et remplissez les valeurs

# ──────────────────────────────────────────────────
# SCRAPING (scrape.py + GitHub Actions)
# ──────────────────────────────────────────────────

# Clé API TMDB – https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Clé SERVICE ROLE Supabase (accès admin, écriture en base)
# Supabase Dashboard → Project Settings → API → service_role
# ⚠️ Ne jamais exposer côté client ni sur Vercel
SUPABASE_SERVICE_ROLE_KEY=

# Liste des cinémas au format JSON
# Trouver l'ID dans l'URL Allociné : salle_gen_csalle=P8507.html → P8507
THEATERS=[{"id": "P8507", "name": "Pathé Carré de Soie", "latitude": 45.7641958, "longitude": 4.9212527}]

# ──────────────────────────────────────────────────
# APPLICATION WEB (app.py + Vercel)
# ──────────────────────────────────────────────────

# URL de votre projet Supabase
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=

# Clé ANON publique Supabase (lecture seule, sûre côté client)
SUPABASE_ANON_KEY=

# Titre affiché sur le site
WEBSITE_TITLE=CinéLyon
# Configuration CinéLyon
# Copiez ce fichier en .env et remplissez les valeurs

# Clé API TMDB (The Movie Database)
# Obtenez-la sur https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Titre du site
WEBSITE_TITLE=CinéLyon

# Supabase (pour la sync des favoris)
# Obtenez l'URL et la clé ANON sur https://supabase.com/dashboard/project/.../settings/api
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Liste des cinémas au format JSON
# Exemple:
# THEATERS=[{"name":"Pathé Bellecour","id":"P0017","latitude":45.7578,"longitude":4.8320}]
THEATERS=[]
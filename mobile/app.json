{
  "expo": {
    "name": "CineLyon",
    "slug": "cinelyon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cinelyon",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0d14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.cinelyon.app",
      "infoPlist": {
        "CFBundleDisplayName": "CinéLyon",
        "NSCalendarsUsageDescription": "CinéLyon a besoin d'accéder à votre calendrier pour ajouter vos séances."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0d0d14"
      },
      "package": "fr.cinelyon.app",
      "permissions": [
        "WRITE_CALENDAR",
        "READ_CALENDAR"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-calendar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0d0d14"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-font",
      [
        "@howincodes/expo-dynamic-app-icon",
        {
          "blue": {
            "image": "./assets/icons/Blue.png",
            "ios": "./assets/icons/Blue.png",
            "android": "./assets/icons/Blue.png"
          },
          "bluegradiant": {
            "image": "./assets/icons/BlueGradiant.png",
            "ios": "./assets/icons/BlueGradiant.png",
            "android": "./assets/icons/BlueGradiant.png"
          },
          "cleardark": {
            "image": "./assets/icons/ClearDark.png",
            "ios": "./assets/icons/ClearDark.png",
            "android": "./assets/icons/ClearDark.png"
          },
          "darkblue": {
            "image": "./assets/icons/DarkBlue.png",
            "ios": "./assets/icons/DarkBlue.png",
            "android": "./assets/icons/DarkBlue.png"
          },
          "darkpurple": {
            "image": "./assets/icons/DarkPurple.png",
            "ios": "./assets/icons/DarkPurple.png",
            "android": "./assets/icons/DarkPurple.png"
          },
          "puplebluegradiant": {
            "image": "./assets/icons/PupleBlueGradiant.png",
            "ios": "./assets/icons/PupleBlueGradiant.png",
            "android": "./assets/icons/PupleBlueGradiant.png"
          },
          "puprplegradiant": {
            "image": "./assets/icons/PuprpleGradiant.png",
            "ios": "./assets/icons/PuprpleGradiant.png",
            "android": "./assets/icons/PuprpleGradiant.png"
          },
          "purple": {
            "image": "./assets/icons/Purple.png",
            "ios": "./assets/icons/Purple.png",
            "android": "./assets/icons/Purple.png"
          },
          "tinteddark": {
            "image": "./assets/icons/TintedDark.png",
            "ios": "./assets/icons/TintedDark.png",
            "android": "./assets/icons/TintedDark.png"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}